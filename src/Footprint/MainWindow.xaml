<Window x:Class="Footprint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Footprint — コマンド履歴" Icon="Assets/Footprint.ico" Width="1100" Height="800" MinWidth="780" MinHeight="620"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource LabelForeground}"
        Loaded="Window_Loaded" Closing="Window_Closing"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="WorkspaceTabStyle" TargetType="TabItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource LabelForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0"
                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource TabHoverBackground}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WorkspaceBackground}" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TabBorder" Property="Margin" Value="0,0,0,-4" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="TabActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="Black" /></Style>
        <Style TargetType="DataGrid"><Setter Property="Foreground" Value="Black" /></Style>
    </Window.Resources>
    <Grid x:Name="LayoutGrid" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="WorkspaceRow" Height="3*" MinHeight="220" />
            <RowDefinition x:Name="HistoryDividerRow" Height="8" />
            <RowDefinition x:Name="HistoryRow" Height="3*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0" Panel.ZIndex="1">
            <Button Content="ヘルプ" Click="Help_Click" ToolTip="使い方とショートカット（F1）"
                    DockPanel.Dock="Right" Style="{StaticResource TabActionButtonStyle}" />
            <Button Content="設定" Click="Settings_Click" ToolTip="テーマと文字サイズを変更"
                    DockPanel.Dock="Right" Style="{StaticResource TabActionButtonStyle}" />
            <Button x:Name="RequestIssueButton" Content="要望" Click="RequestIssue_Click" ToolTip="要望をGitHub Issueとして送信"
                    DockPanel.Dock="Right" Style="{StaticResource TabActionButtonStyle}" />
            <StackPanel Orientation="Horizontal" Height="40">
                <TabControl x:Name="WorkspaceTabs" Height="40" SelectionChanged="WorkspaceTabs_SelectionChanged"
                            PreviewMouseMove="WorkspaceTabs_PreviewMouseMove" HorizontalAlignment="Left"
                            ItemContainerStyle="{StaticResource WorkspaceTabStyle}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" />
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>
                <Button Content="＋" Click="AddTab_Click" ToolTip="タブを追加（Ctrl + T）"
                        Width="28" Style="{StaticResource TabActionButtonStyle}" />
                <Button x:Name="CloseTabButton" Content="×" Click="CloseTab_Click" ToolTip="現在のタブを閉じる（Ctrl + W）"
                        Width="28" Style="{StaticResource TabActionButtonStyle}" />
                <Button x:Name="MergeTabsButton" Content="元のウィンドウにまとめる" Click="MergeTabs_Click"
                        Style="{StaticResource TabActionButtonStyle}" />
                <Button x:Name="RestoreTabsButton" Content="復元" Click="RestoreTabs_Click"
                        Visibility="Collapsed" ToolTip="前回終了時のタブを復元"
                        Style="{StaticResource TabActionButtonStyle}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,-1,0,12" Padding="10"
                BorderThickness="0" Background="{DynamicResource WorkspaceBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="CommandRow" Height="2*" MinHeight="90" />
                    <RowDefinition Height="8" />
                    <RowDefinition x:Name="OutputRow" Height="3*" MinHeight="100" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="シェル" Margin="0,0,0,4" />
                        <ComboBox x:Name="ShellBox" SelectedIndex="0" Padding="6">
                            <ComboBoxItem Content="コマンドプロンプト" /><ComboBoxItem Content="Windows PowerShell" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="作業フォルダー（フォルダーをドラッグ＆ドロップできます）" Margin="0,0,0,4" />
                        <TextBox x:Name="DirectoryBox" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton x:Name="CommandWrapButton" Width="30" Height="26" Margin="4,0"
                                          Background="{DynamicResource WorkspaceBackground}" BorderBrush="{DynamicResource SplitterBackground}"
                                          Click="CommandWrap_Click" ToolTip="折り返しなし（クリックで右端で折り返し）"
                                          AutomationProperties.Name="右端での折り返しを切り替え">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="WrapBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="3" Padding="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="WrapBorder" Property="Background" Value="{DynamicResource TabHoverBackground}" /></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="WrapBorder" Property="BorderThickness" Value="2" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Path Stroke="{DynamicResource LabelForeground}" StrokeThickness="1.6" Width="18" Height="16" Stretch="Uniform"
                                      Data="M 1,2 L 17,2 M 1,7 L 13,7 Q 18,7 18,11 Q 18,15 13,15 L 8,15 M 11,12 L 8,15 L 11,18" />
                            </ToggleButton>
                            <Button x:Name="FormatCommandButton" Width="30" Height="26" Padding="4,2"
                                    Click="FormatCommand_Click" ToolTip="オプションと値をまとめて複数行に整形（Ctrl + Z で元に戻す）"
                                    AutomationProperties.Name="コマンドを複数行に整形">
                                <Path Stroke="#182635" StrokeThickness="1.6" Width="18" Height="16" Stretch="Uniform"
                                      Data="M 1,2 L 18,2 M 1,8 L 12,8 M 1,14 L 12,14 M 17,6 L 17,16 M 14,13 L 17,16 L 20,13" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="コマンド（複数行可・Shift + Enter で実行）" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="CommandBox" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                             FontSize="{DynamicResource CommandFontSize}"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="CommandBox_PreviewKeyDown" />
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="RunButton" Content="実行" Click="Run_Click" IsEnabled="False" />
                            <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel x:Name="ExecutionIndicator" Visibility="Collapsed" VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite">
                            <TextBlock x:Name="ExecutionStateText" FontWeight="Bold" Text="実行中" />
                            <TextBlock Text="実行中は入力を変更できません。中断するには「停止」を押してください。"
                                       FontSize="12" TextWrapping="Wrap" />
                            <ProgressBar x:Name="ExecutionProgress" Height="4" Margin="0,4,12,0" IsIndeterminate="False" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
                <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource WindowBackground}" Cursor="SizeNS" />
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CopyFullOutputButton" Content="全出力をコピー" Click="CopyOutput_Click" Padding="8,2" ToolTip="全ページの出力をコピー" />
                            <Button x:Name="CopyOutputPageButton" Content="ページをコピー" Click="CopyOutputPage_Click" Padding="8,2" />
                            <Button x:Name="SaveOutputButton" Content="TXTに保存" Click="SaveOutput_Click" Padding="8,2" ToolTip="全出力をUTF-8テキストに書き出す" />
                        </StackPanel>
                        <CheckBox x:Name="AutoScrollBox" Content="末尾へ自動スクロール" IsChecked="True"
                                  DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0"
                                  Checked="AutoScroll_Checked" />
                        <TextBlock Text="出力" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" x:Name="OutputLimitText" Visibility="Collapsed" Margin="0,0,0,4"
                               Text="旧バージョンで保存上限に達した出力です。切り捨てられた部分は復元できません。新しい実行は全出力を圧縮保存します。"
                               TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="FirstOutputPageButton" Content="⏮" Click="FirstOutputPage_Click" Padding="6,2" ToolTip="先頭ページ" AutomationProperties.Name="出力の先頭ページ" />
                        <Button x:Name="PreviousOutputPageButton" Content="◀" Click="PreviousOutputPage_Click" Padding="6,2" ToolTip="前のページ" AutomationProperties.Name="出力の前のページ" />
                        <TextBlock x:Name="OutputPageText" VerticalAlignment="Center" Margin="8,0" />
                        <Button x:Name="NextOutputPageButton" Content="▶" Click="NextOutputPage_Click" Padding="6,2" ToolTip="次のページ" AutomationProperties.Name="出力の次のページ" />
                        <Button x:Name="LastOutputPageButton" Content="⏭" Click="LastOutputPage_Click" Padding="6,2" ToolTip="末尾ページ" AutomationProperties.Name="出力の末尾ページ" />
                    </StackPanel>
                    <TextBox Grid.Row="3" x:Name="OutputBox" IsReadOnly="True" IsUndoEnabled="False" FontFamily="Consolas"
                             FontSize="{DynamicResource CommandFontSize}"
                             Background="#182635" Foreground="#E8EEF5" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Border>
        <GridSplitter x:Name="HistorySplitter" Grid.Row="2" Height="8" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource SplitterBackground}" Cursor="SizeNS" />
        <Grid x:Name="HistoryPanel" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="履歴" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="FavoriteButton" Content="☆ お気に入り" Click="Favorite_Click" IsEnabled="False" />
                    <Button Content="入力に戻す" Click="Reuse_Click" /><Button Content="コピー" Click="Copy_Click" />
                    <Button x:Name="OpenHistoryFolderButton" Click="OpenHistoryFolder_Click" Width="34" Padding="6,4"
                            ToolTip="履歴フォルダーを開く" AutomationProperties.Name="履歴フォルダーを開く">
                        <Path Width="18" Height="16" Stretch="Uniform" Stroke="#182635" StrokeThickness="1.5"
                              Fill="Transparent" Data="M 1,4 L 1,16 L 19,16 L 19,6 L 9,6 L 7,4 Z M 1,6 L 1,2 L 7,2 L 9,4 L 17,4 L 17,6" />
                    </Button>
                </StackPanel>
                <CheckBox x:Name="FavoritesOnlyBox" Content="お気に入りのみ" Margin="0,0,12,0"
                          VerticalAlignment="Center" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed" />
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="コマンド・作業フォルダー・シェルを検索（Ctrl + F）" />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="バックアップ" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="CreateBackupButton" Content="今日のバックアップを保存" Click="CreateBackup_Click" IsEnabled="False" />
                    <Button x:Name="RestoreBackupButton" Content="選択した日付から復元" Click="RestoreBackup_Click" IsEnabled="False" />
                    <Button x:Name="ClearNonFavoriteButton" Content="お気に入り以外を削除" Click="ClearNonFavorite_Click" IsEnabled="False" />
                </StackPanel>
                <ComboBox x:Name="BackupKindBox" Width="100" SelectedIndex="0" SelectionChanged="BackupKind_SelectionChanged" DockPanel.Dock="Left" Margin="0,0,6,0">
                    <ComboBoxItem Content="履歴" /><ComboBoxItem Content="お気に入り" />
                </ComboBox>
                <ComboBox x:Name="BackupDateBox" MinWidth="135" Padding="6" SelectionChanged="BackupDate_SelectionChanged"
                          ToolTip="復元する日別バックアップを選択" />
            </DockPanel>
            <DataGrid Grid.Row="2" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                      SelectionChanged="History_SelectionChanged" MouseDoubleClick="History_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="★" Binding="{Binding FavoriteLabel}" Width="35" />
                    <DataGridTextColumn Header="実行日時" Binding="{Binding TimeLabel}" Width="150" />
                    <DataGridTextColumn Header="シェル" Binding="{Binding ShellLabel}" Width="95" />
                    <DataGridTextColumn Header="コマンド" Binding="{Binding Command}" Width="*" />
                    <DataGridTextColumn Header="作業フォルダー" Binding="{Binding WorkingDirectory}" Width="180" />
                    <DataGridTextColumn Header="結果" Binding="{Binding ResultLabel}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Margin="8,0" VerticalAlignment="Center" />
                <Button x:Name="UpdateApplicationButton" Content="最新版に更新" Click="UpdateApplication_Click"
                        ToolTip="GitHubの安定版を確認し、更新して再起動" Style="{StaticResource TabActionButtonStyle}" />
            </StackPanel>

            <Button x:Name="HistoryToggleButton" Content="▼ 履歴を折りたたむ"
                    Click="ToggleHistory_Click" DockPanel.Dock="Left" Padding="10,4" Margin="0,0,12,0"
                    ToolTip="履歴の展開／折りたたみ（Ctrl + Space）" />
            <TextBlock x:Name="StatusText" Text="履歴を読み込んでいます…" VerticalAlignment="Center"
                       Foreground="{DynamicResource LabelForeground}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
