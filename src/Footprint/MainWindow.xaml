<Window x:Class="Footprint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Footprint — コマンド履歴" Width="1100" Height="800" MinWidth="780" MinHeight="620"
        Background="#DCE2EA" Loaded="Window_Loaded" Closing="Window_Closing"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Window.Resources>
        <SolidColorBrush x:Key="WorkspaceBackground" Color="#F9FBFF" />
        <Style x:Key="WorkspaceTabStyle" TargetType="TabItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0"
                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#E8EDF4" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource WorkspaceBackground}" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TabBorder" Property="Margin" Value="0,0,0,-4" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="TabActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="220" />
            <RowDefinition Height="8" />
            <RowDefinition Height="3*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0" Panel.ZIndex="1">
            <StackPanel Orientation="Horizontal" Height="40">
                <TabControl x:Name="WorkspaceTabs" Height="40" SelectionChanged="WorkspaceTabs_SelectionChanged"
                            PreviewMouseMove="WorkspaceTabs_PreviewMouseMove" HorizontalAlignment="Left"
                            ItemContainerStyle="{StaticResource WorkspaceTabStyle}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" />
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>
                <Button Content="＋" Click="AddTab_Click" ToolTip="タブを追加"
                        Width="28" Style="{StaticResource TabActionButtonStyle}" />
                <Button x:Name="CloseTabButton" Content="×" Click="CloseTab_Click" ToolTip="現在のタブを閉じる"
                        Width="28" Style="{StaticResource TabActionButtonStyle}" />
                <Button x:Name="MergeTabsButton" Content="元のウィンドウにまとめる" Click="MergeTabs_Click"
                        Style="{StaticResource TabActionButtonStyle}" />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,-1,0,12" Padding="10"
                BorderThickness="0" Background="{StaticResource WorkspaceBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="70" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="80" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="シェル" Margin="0,0,0,4" />
                        <ComboBox x:Name="ShellBox" SelectedIndex="0" Padding="6">
                            <ComboBoxItem Content="コマンドプロンプト" /><ComboBoxItem Content="Windows PowerShell" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="作業フォルダー（フォルダーをドラッグ＆ドロップできます）" Margin="0,0,0,4" />
                        <TextBox x:Name="DirectoryBox" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="コマンド（複数行可）" Margin="0,0,0,4" />
                <TextBox Grid.Row="2" x:Name="CommandBox" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />
                <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="#DCE2EA" Cursor="SizeNS" />
                <DockPanel Grid.Row="4" Margin="0,2">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="RunButton" Content="実行" Click="Run_Click" IsEnabled="False" />
                        <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="出力" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
                <TextBox Grid.Row="5" x:Name="OutputBox" IsReadOnly="True" FontFamily="Consolas"
                         Background="#182635" Foreground="#E8EEF5" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="#B6C1CE" Cursor="SizeNS" />
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="履歴" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="FavoriteButton" Content="☆ お気に入り" Click="Favorite_Click" IsEnabled="False" />
                    <Button Content="入力に戻す" Click="Reuse_Click" /><Button Content="コピー" Click="Copy_Click" />
                </StackPanel>
                <CheckBox x:Name="FavoritesOnlyBox" Content="お気に入りのみ" Margin="0,0,12,0"
                          VerticalAlignment="Center" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed" />
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="コマンド・作業フォルダー・シェルを検索" />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="バックアップ" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="CreateBackupButton" Content="今日のバックアップを保存" Click="CreateBackup_Click" IsEnabled="False" />
                    <Button x:Name="RestoreBackupButton" Content="選択した日付から復元" Click="RestoreBackup_Click" IsEnabled="False" />
                    <Button x:Name="ClearNonFavoriteButton" Content="お気に入り以外を削除" Click="ClearNonFavorite_Click" IsEnabled="False" />
                </StackPanel>
                <ComboBox x:Name="BackupDateBox" MinWidth="135" Padding="6" SelectionChanged="BackupDate_SelectionChanged"
                          ToolTip="復元する日別バックアップを選択" />
            </DockPanel>
            <DataGrid Grid.Row="2" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                      SelectionChanged="History_SelectionChanged" MouseDoubleClick="History_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="★" Binding="{Binding FavoriteLabel}" Width="35" />
                    <DataGridTextColumn Header="実行日時" Binding="{Binding TimeLabel}" Width="150" />
                    <DataGridTextColumn Header="シェル" Binding="{Binding ShellLabel}" Width="95" />
                    <DataGridTextColumn Header="コマンド" Binding="{Binding Command}" Width="*" />
                    <DataGridTextColumn Header="作業フォルダー" Binding="{Binding WorkingDirectory}" Width="180" />
                    <DataGridTextColumn Header="結果" Binding="{Binding ResultLabel}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="履歴を読み込んでいます…" Margin="0,10,0,0"
                   Foreground="#526579" TextWrapping="Wrap" />
    </Grid>
</Window>
