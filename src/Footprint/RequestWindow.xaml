<Window x:Class="Footprint.RequestWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Footprint — 要望と実装" Width="650" Height="670" MinWidth="560" MinHeight="620"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="20">
  <TextBlock Text="要望 → Issue → 実装・ビルド → 更新" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource LabelForeground}" />
  <TextBlock Text="要望は公開Issueとして送信されます。個人情報や秘密を含めないでください。&#10;コマンドや出力、履歴は自動で送信しません。" TextWrapping="Wrap" Margin="0,10" Foreground="{DynamicResource LabelForeground}" />
  <TextBlock Text="GitHubトークン（この画面を閉じると破棄・保存しません）" Foreground="{DynamicResource LabelForeground}" />
  <PasswordBox x:Name="TokenBox" Margin="0,5" Padding="6" />
  <WrapPanel><Button Content="認証・自動実装の設定手順" Click="Setup_Click" Margin="0,4,8,8" Padding="8,4" />
   <Button Content="ブラウザーでIssue作成" Click="BrowserIssue_Click" Margin="0,4,0,8" Padding="8,4" /></WrapPanel>
  <TextBlock Text="タイトル" Foreground="{DynamicResource LabelForeground}" />
  <TextBox x:Name="TitleBox" MaxLength="200" Margin="0,5" Padding="6" />
  <TextBlock Text="要望・再現手順・期待する動作" Foreground="{DynamicResource LabelForeground}" />
  <TextBox x:Name="BodyBox" Height="145" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="60000" Margin="0,5" Padding="6" />
  <Button x:Name="CreateButton" Content="Issueを追加" Click="Create_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,5" />
  <Separator Margin="0,10" />
  <WrapPanel VerticalAlignment="Center">
   <TextBlock Text="Issue番号 #" VerticalAlignment="Center" Foreground="{DynamicResource LabelForeground}" />
   <TextBox x:Name="IssueNumberBox" Width="90" Padding="6" Margin="5,0" />
   <Button x:Name="ImplementButton" Content="実装・ビルドを依頼" Click="Implement_Click" Padding="12,6" />
  </WrapPanel>
  <TextBlock Text="実装はGitHub Actions上で処理します（管理者の事前設定が必要）。&#10;完成するとPRと試用ZIPが作られます。正式版はPRの確認・マージ・リリース後に更新できます。" TextWrapping="Wrap" Margin="0,10" Foreground="{DynamicResource LabelForeground}" />
  <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Height="4" Visibility="Collapsed" />
  <TextBlock x:Name="StatusText" Text="タイトルと要望を入力してください。" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource LabelForeground}" AutomationProperties.LiveSetting="Polite" />
  <WrapPanel>
   <Button Content="Issue・進捗" Click="Issue_Click" Padding="8,4" Margin="0,4,8,0" />
   <Button Content="実行状況・ビルド結果" Click="Runs_Click" Padding="8,4" Margin="0,4,8,0" />
   <Button x:Name="UpdateButton" Content="最新版を確認・更新" Click="Update_Click" Padding="8,4" Margin="0,4,0,0" />
  </WrapPanel>
 </StackPanel>
 </ScrollViewer>
</Window>
